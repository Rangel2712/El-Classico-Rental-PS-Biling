{
  "name": "elclassico-billing-desktop",
  "productName": "El Classico Billing",
  "version": "1.6.0",
  "description": "El Classico Rental PS Billing — Server & Panel Kasir",
  "author": "El Classico Rental PS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --x64 --publish never"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.elclassico.billing.desktop",
    "productName": "El Classico Billing",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "launcher.html", "build/icon.png"],
    "extraResources": [
      { "from": "../server", "to": "server", "filter": ["**/*", "!data/**"] }
    ],
    "win": {
      "target": [ { "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] } ],
      "icon": "build/icon.png",
      "artifactName": "ElClassico-Billing-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "El Classico Billing"
    },
    "portable": { "artifactName": "ElClassico-Billing-${version}-portable.exe" },
    "mac": {
      "target": [ { "target": "dmg", "arch": ["x64"] } ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "minimumSystemVersion": "10.15",
      "artifactName": "ElClassico-Billing-${version}-mac.${ext}"
    }
  }
}
